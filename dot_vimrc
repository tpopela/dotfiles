function! ProjectCompile (shift)
  if match (expand ('%:p'), 'evolution') != -1
    if (a:shift)
      :!clear && mi v
    else
      :!clear && mi
    endif
  elseif match (expand ('%:p'), 'WebKit') != -1
    if (a:shift)
      :!clear && bwd
    else
      :!clear && bw
    endif
  else
    :!clear && b
  endif
endfunction

nmap <F5> :call ProjectCompile("") <CR>
imap <F5> <ESC>:call ProjectCompile("shift") <CR>

function! ProjectSetEnv ()
  let project_evo = 0
  let project_evo_wk2 = 1
  let project_wk = 0
  let project_none = 0

  if match (expand ('%:p'), 'evolution') != -1
    let project_evo = 1
    if match (expand ('%:p'), 'wk1') != -1
      let project_evo_wk2 = 0
    endif
  elseif match (expand ('%:p'), 'WebKit') != -1
    let project_wk = 1
  else
    let project_none = 0
  endif

  if project_wk
    set tabstop=4
    set expandtab
    set shiftwidth=4
  endif

  if project_evo
    set tabstop=8
  endif

  if project_evo_wk2
    let @w = "o{ WebKitDOMDocument *dom_document = document; gchar *body_content = webkit_dom_element_get_outer_html (WEBKIT_DOM_ELEMENT (webkit_dom_document_get_body (dom_document))); printf (\"BODY CONTENT DUMP IN %s:%d\\n%s\\n\", __PRETTY_FUNCTION__, __LINE__, body_content); g_free (body_content);}^^"
  else
    let @w = "o{ WebKitDOMDocument *dom_document = webkit_web_view_get_dom_document (WEBKIT_WEB_VIEW (view)); gchar *body_content = webkit_dom_html_element_get_outer_html (WEBKIT_DOM_HTML_ELEMENT (webkit_dom_document_get_body (dom_document))); printf (\"BODY CONTENT DUMP IN %s:%d\\n%s\\n\", __PRETTY_FUNCTION__, __LINE__, body_content); g_free (body_content);}^^"
  endif
  let @s = "oprintf (\"%s:%d\\n\", __PRETTY_FUNCTION__, __LINE__);"
  let @e = "oGTimer *timer = g_timer_new ();"
  let @d = "o{ GTimer* timer_end = timer; g_timer_stop (timer_end); printf (\"Elapsed Time for %s:%d: %lf ms\\n\", __PRETTY_FUNCTION__, __LINE__, g_timer_elapsed (timer_end, NULL) * 1000.0); g_timer_destroy (timer_end); }^"
  if project_evo_wk2
    let @n = "o{ WebKitDOMNode *tested = WEBKIT_DOM_NODE (); const gchar* prefix = \"\"; if (WEBKIT_DOM_IS_TEXT (tested)) { gchar *node_text_content = webkit_dom_node_get_text_content (tested); printf (\"%s text - \'%s\'\", prefix, node_text_content); g_free (node_text_content); } else if (tested && WEBKIT_DOM_IS_DOCUMENT_FRAGMENT (tested)) { printf (\"%s - \'%s\'\", prefix, dom_get_node_inner_html (tested)); } else if (tested && !WEBKIT_DOM_IS_ELEMENT (tested)) printf (\"%s %s\", prefix, G_OBJECT_TYPE_NAME (tested)); else if (tested) printf (\"%s %s #\'%s\' .\'%s\' - \'%s\'\", prefix, WEBKIT_DOM_IS_ELEMENT (tested) ? webkit_dom_element_get_tag_name (WEBKIT_DOM_ELEMENT (tested)) : \"\", webkit_dom_element_get_id (WEBKIT_DOM_ELEMENT (tested)), webkit_dom_element_get_class_name (WEBKIT_DOM_ELEMENT (tested)), webkit_dom_element_get_outer_html (WEBKIT_DOM_ELEMENT (tested))); else printf (\"%s NULL\", prefix); printf (\" at %s:%d\\n\", __PRETTY_FUNCTION__, __LINE__);}^43li"
  else
    let @n = "o{ WebKitDOMNode *tested = WEBKIT_DOM_NODE (); const gchar* prefix = \"\"; if (WEBKIT_DOM_IS_TEXT (tested)) { gchar *node_text_content = webkit_dom_node_get_text_content (tested); printf (\"%s text - \'%s\'\", prefix, node_text_content); g_free (node_text_content); } else if (tested && !WEBKIT_DOM_IS_ELEMENT (tested)) printf (\"%s %s\", prefix, G_OBJECT_TYPE_NAME (tested)); else if (tested) printf (\"%s %s #\'%s\' .\'%s\' - \'%s\'\", prefix, WEBKIT_DOM_IS_ELEMENT (tested) ? webkit_dom_element_get_tag_name (WEBKIT_DOM_ELEMENT (tested)) : \"\", webkit_dom_element_get_id (WEBKIT_DOM_ELEMENT (tested)), webkit_dom_element_get_class_name (WEBKIT_DOM_ELEMENT (tested)), webkit_dom_html_element_get_outer_html (WEBKIT_DOM_HTML_ELEMENT (tested))); else printf (\"%s NULL\", prefix); printf (\" at %s:%d\\n\", __PRETTY_FUNCTION__, __LINE__);}^43li"
  endif
