shopt -s expand_aliases

lcd() {
    cd "$1"; ls --color=always --group-directories-first ;
}

f_find() {
    find . -type f -exec grep -niH "$@" {} \;
}

c_find() {
    find . -type f \( -name "*.c" -o -name "*.cpp" -o -name "*.cc" \) -exec grep -niH "$@" {} \;
}

h_find() {
    find . -type f -name "*.h" -exec grep -niH "$@" {} \;
}

s_find() {
    find . -type f \( -name "*.c" -o -name "*.cpp" -o -name "*.cc" -o -name "*.h" \) -exec grep -niH "$@" {} \;
}

gn_find() {
    find . -type f \( -name "*.gn" -o -name "*.gni" \) -exec grep -niH "$@" {} \;
}

d_find() {
    find . -type d -exec grep -niH "$@" {} \;
}

gg_vim() {
    vim $(git grep --name-only "$@")
}

parse_git_branch() {
    git branch --no-color 2> /dev/null | sed -e '/^[^*]/d' -e 's/^* //g'
}

parse_git_branch_ps() {
    (parse_git_branch) | sed -e "s/\\(.*\\)/\\[\\1\\]/"
}

parse_git_branch_name() {
    branch=$(git symbolic-ref --short -q HEAD 2> /dev/null)
    if [ -z "$branch" ]; then
        branch=$(git branch --no-color --contains HEAD 2> /dev/null | tail -n 1 | xargs echo)
    fi
    echo "$branch"
}

current_repo_is_dirty() {
    label=""
    if [[ $(git diff --shortstat 2> /dev/null | tail -n1) != "" ]]; then
        label=$label"[*]"
    fi
    if [[ $(git diff --cached --shortstat 2> /dev/null | tail -n1) != "" ]]; then
        label=$label"[+]"
    fi
    echo "$label"
}

gar() {
    pushd "$PROJECTS_DIR/upstream/getfit" > /dev/null || : && node getfit && popd > /dev/null || :
}

setup-swapfile() {
    sudo "$HOME"/.local/bin/setup-swapfile
}

